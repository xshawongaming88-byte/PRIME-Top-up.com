@keyframes wave { 
  0% { transform: translate(-100%); }
  50% { transform: translate(100%); }
  100% { transform: translate(100%); }
}

@keyframes pulse { 
  0% { opacity: 0.3; }
  10% { opacity: 1; }
  100% { opacity: 0.3; }
}

