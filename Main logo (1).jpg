@layer utilities {
  .\[container-type\:inline-size\] { container-type: inline-size; }
  .pointer-events-auto { pointer-events: auto; }
  .pointer-events-none { pointer-events: none; }
  .collapse { visibility: collapse; }
  .invisible { visibility: unset; }
  .visible { visibility: visible; }
  .sr-only { clip-path: inset(50%); white-space: nowrap; border-width: 0px; width: 1px; height: 1px; margin: -1px; padding: 0px; position: absolute; overflow: hidden; }
  .absolute { position: absolute; }
  .fixed { position: fixed; }
  .relative { position: relative; }
  .static { position: static; }
  .sticky { position: sticky; }
  .inset-0 { inset: calc(var(--base-size-4) * 0); }
  .inset-x-0 { inset-inline: calc(var(--base-size-4) * 0); }
  .inset-y-0 { inset-block: calc(var(--base-size-4) * 0); }
  .start { inset-inline-start: var(--base-size-4); }
  .start-3 { inset-inline-start: calc(var(--base-size-4) * 3); }
  .end { inset-inline-end: var(--base-size-4); }
  .end-0, .inset-e-0 { inset-inline-end: calc(var(--base-size-4) * 0); }
  .inset-e-2 { inset-inline-end: calc(var(--base-size-4) * 2); }
  .top-0 { top: calc(var(--base-size-4) * 0); }
  .top-1\.5 { top: calc(var(--base-size-4) * 1.5); }
  .top-1\/2 { top: 50%; }
  .right-1 { right: calc(var(--base-size-4) * 1); }
  .bottom-0 { bottom: calc(var(--base-size-4) * 0); }
  .left-1 { left: calc(var(--base-size-4) * 1); }
  .left-1\.5 { left: calc(var(--base-size-4) * 1.5); }
  .left-1\/2 { left: 50%; }
  .left-2 { left: calc(var(--base-size-4) * 2); }
  .left-\[7px\] { left: 7px; }
  .isolate { isolation: isolate; }
  .z-1 { z-index: 1; }
  .z-2 { z-index: 2; }
  .z-10 { z-index: 10; }
  .z-20 { z-index: 20; }
  .z-base { z-index: 0; }
  .z-context-menu { z-index: 80; }
  .z-modal { z-index: var(--zIndex-modal); }
  .z-overlay { z-index: var(--zIndex-overlay); }
  .z-raised { z-index: 20; }
  .z-sticky { z-index: var(--zIndex-sticky); }
  .col-span-full { grid-column: 1 / -1; }
  .col-start-1 { grid-column-start: 1; }
  .col-start-2 { grid-column-start: 2; }
  .container { width: 100%; }
  @media (width >= 20rem) {
  .container { max-width: 20rem; }
}
  @media (width >= 34rem) {
  .container { max-width: 34rem; }
}
  @media (width >= 48rem) {
  .container { max-width: 48rem; }
}
  @media (width >= 63.25rem) {
  .container { max-width: 63.25rem; }
}
  @media (width >= 80rem) {
  .container { max-width: 80rem; }
}
  @media (width >= 87.5rem) {
  .container { max-width: 87.5rem; }
}
