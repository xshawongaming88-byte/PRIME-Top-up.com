}

@media (width >= 768px) {
  .AvatarShowLarge { display: inherit !important; }
  .react-tree-show-tree-items-on-large-screen { display: block; }
  .AvatarShowMedium { display: inherit !important; }
  .react-code-view-bottom-padding { margin-bottom: var(--base-size-16); }
