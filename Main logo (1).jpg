.react-directory-row { height: 40px; font-size: var(--text-body-size-medium); }

.react-directory-row td { padding-left: var(--base-size-16); text-align: left; border-top: var(--borderWidth-thin) solid var(--borderColor-default,var(--color-border-default)); }

.react-directory-row:hover { background-color: var(--bgColor-muted,var(--color-canvas-subtle)); }

.react-directory-filename-column { height: 40px; padding-right: var(--base-size-16); align-items: center; gap: 4px 10px; display: flex; }

.react-directory-filename-column .react-directory-filename-cell { font-size: var(--text-body-size-medium); font-weight: var(--base-text-weight-normal); margin: 0px; }

.react-directory-filename-column .icon-directory { color: var(--treeViewItem-leadingVisual-iconColor-rest,var(--color-icon-directory)); }

.react-directory-truncate { text-overflow: ellipsis; white-space: nowrap; vertical-align: top; max-width: 100%; display: inline-block; overflow: hidden; }

.react-directory-commit-message { text-overflow: ellipsis; white-space: nowrap; max-width: 100%; overflow: hidden; }

.react-directory-commit-age { padding-right: var(--base-size-16); color: var(--fgColor-muted,var(--color-fg-muted)); text-align: right; }

.react-tree-toggle-button-with-indicator::after { top: 3px; right: calc(var(--base-size-4) / 2); width: var(--base-size-8,8px); height: var(--base-size-8,8px); content: ""; background: var(--bgColor-accent-emphasis,var(--color-accent-fg)); border: var(--borderWidth-thick) solid var(--bgColor-default,var(--color-canvas-default)); border-radius: 50%; display: inline-block; position: absolute; }

.react-repos-overview-margin { --Layout-gutter: 24px; }

@media screen and (width >= 1280px) {
  .react-repos-overview-margin { margin-right: calc(50% - 678px); }
