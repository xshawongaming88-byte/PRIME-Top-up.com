.flash-success:not(.Banner) .octicon { color: var(--fgColor-success); }

.flash-full:not(.Banner) { margin-top: calc(var(--borderWidth-thin) * -1); border-width: var(--borderWidth-thin) 0; border-radius: 0px; }

.flash-banner { z-index: 90; border-top: 0px; border-left: 0px; border-right: 0px; border-radius: 0px; width: 100%; position: fixed; top: 0px; }

.flash-banner, .flash-full { background-color: var(--bgColor-default); }

.warning { font-weight: var(--base-text-weight-semibold); background-color: var(--bgColor-attention-muted); margin-bottom: 0.8em; padding: 0.5em; }

.labels { position: relative; }

.Label, .label { padding: 0 var(--base-size-6); font-size: var(--text-body-size-small); font-weight: var(--base-text-weight-medium); white-space: nowrap; border: var(--borderWidth-thin) solid var(--borderColor-default); border-radius: var(--borderRadius-full); line-height: 18px; display: inline-block; }

