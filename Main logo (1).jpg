.flash-warn:not(.Banner) { color: var(--fgColor-default); background-image: linear-gradient(var(--bgColor-attention-muted), var(--bgColor-attention-muted)); border-color: var(--borderColor-attention-muted); }

.flash-warn:not(.Banner) .octicon { color: var(--fgColor-attention); }

